<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>GrainWire.Bench</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- "dotnet run" keeps the directory it was started from, so the relative paths of the out and gcdump options are relative to it. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Client" />
    <PackageReference Include="MQTTnet" />
    <ProjectReference Include="../../src/GrainWire.Abstractions/GrainWire.Abstractions.csproj" />
    <ProjectReference Include="../../src/GrainWire.Server/GrainWire.Server.csproj" />
  </ItemGroup>
</Project>
